# HireShelby control plane (`crates/hireshelby-accounts`).
#
# Separate from the root Dockerfile on purpose: that image builds the relay and
# bundles the web UIs, which the control plane neither needs nor should carry.
# This one produces a single static-ish binary on a slim Debian base.
#
# Build from the repository root:
#   docker build -f Dockerfile.accounts -t hireshelby-accounts .

ARG RUST_VERSION=1.95
ARG DEBIAN_VERSION=bookworm

# ─── Stage 1: cargo-chef base ───────────────────────────────────────────────
FROM rust:${RUST_VERSION}-${DEBIAN_VERSION} AS chef
RUN cargo install cargo-chef --locked --version 0.1.71
WORKDIR /build

# ─── Stage 2: plan dependency graph ─────────────────────────────────────────
# Manifests alone determine the recipe, so this layer only rebuilds when
# Cargo.{toml,lock} or a crate manifest changes — not on every source edit.
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# ─── Stage 3: cook dependencies, then build the binary ──────────────────────
FROM chef AS builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        libssl-dev \
        ca-certificates \
        git \
    && rm -rf /var/lib/apt/lists/*
COPY --from=planner /build/recipe.json recipe.json
# Cook the full workspace recipe: the control plane depends on workspace
# siblings, so scoping the cook to one package misses transitive deps and
# rebuilds them in the next layer anyway.
RUN cargo chef cook --release --recipe-path recipe.json
COPY . .
RUN cargo build --release --locked -p hireshelby-accounts --bin hireshelby-accounts \
    && strip target/release/hireshelby-accounts

# ─── Stage 4: runtime ───────────────────────────────────────────────────────
FROM debian:${DEBIAN_VERSION}-slim AS runtime

LABEL org.opencontainers.image.title="HireShelby Accounts" \
      org.opencontainers.image.description="Control plane: accounts, identity binding, community provisioning, and plan quotas" \
      org.opencontainers.image.licenses="Apache-2.0"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        openssl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 1000 hireshelby \
    && useradd  --system --uid 1000 --gid 1000 --home-dir /var/lib/hireshelby \
                --create-home --shell /usr/sbin/nologin hireshelby

COPY --from=builder /build/target/release/hireshelby-accounts /usr/local/bin/hireshelby-accounts

# Must agree with HIRESHELBY_BIND_ADDR below.
EXPOSE 4000
ENV HIRESHELBY_BIND_ADDR=0.0.0.0:4000

# Unauthenticated liveness probe; every other route requires a session.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -fsS http://127.0.0.1:4000/health || exit 1

USER hireshelby:hireshelby
WORKDIR /var/lib/hireshelby

ENTRYPOINT ["/usr/local/bin/hireshelby-accounts"]
